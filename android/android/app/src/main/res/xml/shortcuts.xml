<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <shortcut
        android:shortcutId="add_expense_shortcut"
        android:enabled="true"
        android:icon="@drawable/ic_add_expense_tile"
        android:shortcutShortLabel="@string/shortcut_add_expense_short"
        android:shortcutLongLabel="@string/shortcut_add_expense_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.personalmoneyos.frontend"
            android:targetClass="com.personalmoneyos.frontend.MainActivity"
            android:data="mone://widget?action=add&amp;category=Other" />
    </shortcut>

    <capability android:name="actions.intent.CREATE_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.personalmoneyos.frontend"
            android:targetClass="com.personalmoneyos.frontend.MainActivity"
            android:data="mone://widget?action=add">
            <parameter
                android:name="thing.name"
                android:key="category" />
        </intent>
    </capability>

</shortcuts>
