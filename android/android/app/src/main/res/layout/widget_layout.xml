<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Available Balance"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="₹ ••••••"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal" />
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Add Expense"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        
        <TextView
            android:id="@+id/widget_btn_food"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="Food"
            android:textSize="12sp"
            android:background="#22F59E0B"
            android:textColor="#F59E0B"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:textStyle="bold"
            android:maxLines="1"/>
            
        <TextView
            android:id="@+id/widget_btn_shop"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="Shop"
            android:textSize="12sp"
            android:background="#22EC4899"
            android:textColor="#EC4899"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:textStyle="bold"
            android:maxLines="1"/>
            
        <TextView
            android:id="@+id/widget_btn_travel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="Travel"
            android:textSize="12sp"
            android:background="#223B82F6"
            android:textColor="#3B82F6"
            android:gravity="center"
            android:textStyle="bold"
            android:maxLines="1"/>
            
    </LinearLayout>

</LinearLayout>
